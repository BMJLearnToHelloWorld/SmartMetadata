# Empty = same-origin /api (Vite proxies /api to the slim server).
# For a built SPA on another host use the API origin + /api, e.g.
# VITE_API_BASE_URL=http://localhost:8585/api
VITE_API_BASE_URL=

# Proxy target for `npm run dev`. Match docs/rebuild/PHASE0.md (port 8585).
VITE_API_PROXY_TARGET=http://localhost:8585
