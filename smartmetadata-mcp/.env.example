# Apache openmetadata-service origin. A bare host is rewritten to …/api.
# Default: http://localhost:8585
OM_API_URL=http://localhost:8585

# Bot JWT or PAT. Required. Never commit a real token.
OM_JWT=

# Optional request timeout in milliseconds (default 30000, max 120000).
# OM_TIMEOUT_MS=30000

# Optional read-only mode: true/1 hides the write tools and refuses their calls (default off).
# Read at startup; restart the server to change it.
# OM_MCP_READ_ONLY=false

# Optional comma-separated tool names to hide and refuse (default empty; unknown names only warn).
# Read at startup; restart the server to change it.
# OM_MCP_DISABLED_TOOLS=
