# Product MCP image. Builds smartmetadata-mcp (stdio). Context is the repo root.
# FROM-scope ARGs must sit above the first FROM. Docker 29 / BuildKit treats a
# between-stage ARG as stage-local and blanks compose-passed NODE_IMAGE
# (China overlay). Mirror Dockerfile.ui: one top-level ARG, reuse across stages.
ARG NODE_IMAGE=node:22-bookworm-slim
FROM ${NODE_IMAGE} AS build
WORKDIR /app
COPY smartmetadata-mcp/package.json smartmetadata-mcp/package-lock.json ./
RUN npm ci
COPY smartmetadata-mcp/ ./
RUN npm run build && npm prune --omit=dev

FROM ${NODE_IMAGE}
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/package.json /app/package-lock.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY docker/rebuild/mcp-entrypoint.sh /mcp-entrypoint.sh
RUN chmod 755 /mcp-entrypoint.sh
ENTRYPOINT ["/mcp-entrypoint.sh"]