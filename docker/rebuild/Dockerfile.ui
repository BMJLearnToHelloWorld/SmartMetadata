# Product Vue SPA. Builds smartmetadata-ui and serves it with nginx.
# Context is the repo root. Same-origin /api is proxied to the slim server.
ARG NODE_IMAGE=node:22-bookworm-slim
FROM ${NODE_IMAGE} AS build
WORKDIR /app
COPY smartmetadata-ui/package.json smartmetadata-ui/package-lock.json ./
RUN npm ci
COPY smartmetadata-ui/ ./
ENV VITE_API_BASE_URL=
RUN npm run build

ARG NGINX_IMAGE=nginx:1.27-alpine
FROM ${NGINX_IMAGE}
COPY --from=build /app/dist /usr/share/nginx/html
COPY docker/rebuild/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
